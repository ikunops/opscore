# OpsCore Control Plane configuration — KEY=VALUE, one per line.
# Copy to opscore.env and edit. CLI flags override these values.
# Resolution order per setting: CLI flag > opscore.env > OPESCORE_<KEY> env > built-in default.
# Booleans accept: 1/true/yes/on/y (case-insensitive).

# --- HTTP server ---
addr=:8080

# --- Storage ---
# memory (default, local dev)  |  sqlite (persistent)
storage=memory
db=opscore.db

# --- Bootstrap admin (created on first run) ---
admin-user=admin
admin-pass=change-me

# --- JWT signing secret ---
# REQUIRED (non-default) for sqlite / non-demo deployments; use a long random string.
# The server refuses to start if this is still the "change-me-in-prod" default in those modes.
jwt-secret=change-me-in-prod

# --- Open self-registration (default off; security surface) ---
allow-register=false

# --- Demo mode (embedded fake host for local UI preview) ---
demo=false

# --- Default remote target (every operation runs here over SSH unless overridden per-request) ---
target-host=
target-port=22
target-user=root
target-pass=
target-key=
target-insecure=false
target-sudo=false
